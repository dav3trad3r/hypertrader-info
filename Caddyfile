# Railpack serves the Vite build with Caddy and uses this file instead of its
# default template when it sits at the repo root. Based on Railpack's
# core/providers/node/Caddyfile.template, with three changes:
#   1. Hashed /assets/* are immutable: cache for a year at the browser and at
#      Cloudflare (the default left Cloudflare mostly MISSing and revalidating).
#   2. index.html is never cached, so a deploy is picked up on the next load.
#   3. Scanner probes (/.env, /@fs/.env, *.php, wp-*) get a 404 instead of the
#      SPA fallback's 200 + index.html, which kept inviting them back and counted
#      as "pageviews" in analytics.

{
	admin off
	persist_config off
	auto_https off

	log {
		format json
	}

	servers {
		trusted_proxies static private_ranges 100.0.0.0/8 # trust railway's proxy
	}
}

:{$PORT:80} {
	log {
		format json
	}

	respond /health 200

	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	# Vulnerability scanners: answer 404 before the SPA fallback can say 200.
	@scanner {
		path /.env* /*/.env* /.git/* /*/.git/* /@fs/* /@vite/* /*.php /*.php/* /wp-admin* /wp-login* /wp-includes/* /wp-content/* /xmlrpc.php /userfiles* /.amper/* /cgi-bin/* /vendor/phpunit/* /.aws/* /.ssh/* /config.json /phpinfo* /telescope/* /_profiler/* /actuator/* /server-status
	}
	respond @scanner 404

	root * dist

	# Vite names bundles by content hash, so they never change under one name.
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"

	# Fonts, images and the OG card live at the root; revalidate daily.
	@media path *.png *.svg *.jpg *.jpeg *.gif *.webp *.avif *.ico *.woff *.woff2
	header @media Cache-Control "public, max-age=86400"

	# The shell must always be fresh so new bundles are picked up.
	@html path / /index.html
	header @html Cache-Control "no-cache"

	file_server {
		hide .git
		hide .env*
	}

	encode {
		gzip
		zstd
	}

	try_files {path} {path}.html {path}/index.html /index.html
}
